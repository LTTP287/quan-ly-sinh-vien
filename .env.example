# ====================================================================
# Sao chép file này thành .env.local rồi điền giá trị thật.
# CHƯA điền => app tự chạy ở "chế độ demo" bằng localStorage (không bảo mật).
# ====================================================================

# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# BÍ MẬT — chỉ dùng ở server (Route Handler tạo tài khoản sinh viên từ Excel).
# TUYỆT ĐỐI không đặt tiền tố NEXT_PUBLIC_ cho khóa này.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Tên miền email nội bộ sinh ra từ MSSV (20120001 -> 20120001@<domain>)
NEXT_PUBLIC_STUDENT_EMAIL_DOMAIN=student.university.edu.vn

# Mật khẩu mặc định cấp cho sinh viên khi import từ Excel
DEFAULT_STUDENT_PASSWORD=SinhVien@2026

# Khóa bí mật ký JWT Session (tối thiểu 32 ký tự ngẫu nhiên)
AUTH_JWT_SECRET=your-custom-jwt-secret-key-at-least-32-chars-long

# Cấu hình tài khoản Giảng viên / Chủ hệ thống (Owner) riêng tư của Thầy/Cô:
# Điền email và mật khẩu tại đây để đăng nhập Cổng Giảng Viên an toàn mà không bị lộ lên Git:
OWNER_EMAIL=giangvien@edu.vn
OWNER_NAME=ThS. Lê Thị Thanh Phương
OWNER_PASSWORD=your-secure-password
